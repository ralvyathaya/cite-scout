{
  "name": "citescout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "deploy:preview": "npm run build && wrangler versions upload --config wrangler.production.jsonc --preview-alias staging"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "recharts": "latest",
    "resend": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/vitest-plugin": "1.1.10",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "0.31.10",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
