{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "citescout-staging",
  "main": "./dist/citescout/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/check-staging.mjs" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "citescout-staging",
      "database_id": "35be5adc-b1c8-48ab-86d8-debb1f131551",
      "migrations_dir": "./migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "OPERATOR_SECRET", "RESEND_API_KEY", "TURNSTILE_SECRET_KEY"],
  },
  "vars": {
    "APP_URL": "https://staging.cite-scout.com",
    "APP_ENV": "production",
    "DEPLOYMENT_ENV": "staging",
    "EXTERNAL_INTEGRATIONS_ENABLED": "true",
    "V2_SCANS_ENABLED": "true",
    "GEO_SCANS_ENABLED": "false",
    "GEO_ANALYSIS_ENABLED": "false",
    "GEO_CLASSIFIER_MODEL": "clef-flash",
    "GEO_SERP_COLLECTOR": "serpapi",
    "GEO_OPENAI_MODEL": "gpt-6-luna",
    "ONBOARDING_SUGGESTIONS_DAILY_CAP": "0",
    "ONBOARDING_SUGGESTIONS_TOTAL_BUDGET_USD": "0",
    "GEO_PROCESSING_PROJECT_DAILY_CAP": "0",
    "GEO_PROCESSING_GLOBAL_DAILY_CAP": "0",
    "GEO_PAGE_CHECKS_ENABLED": "false",
    "GEO_GLOBAL_DAILY_CALL_CAP": "0",
    "GEO_PROJECT_DAILY_CALL_CAP": "0",
    "GEO_PROJECT_MONTHLY_CALL_CAP": "0",
    "GEO_SERPAPI_MONTHLY_REQUEST_CAP": "0",
    "GEO_INTERNAL_TEST_SPEND_CAP_USD": "0",
    "GEO_INTERNAL_TEST_LIMITS": "{\"observations\":0,\"openai\":0,\"perplexity\":0,\"serpapi\":0,\"classifier\":0}",
    "GEO_INTERNAL_TEST_PERPLEXITY_MAX_COST_USD": "0",
    "GEO_INTERNAL_TEST_OPENAI_MAX_COST_USD": "0",
    "GEO_INTERNAL_TEST_PROCESSING_MAX_COST_USD": "0",
    "TEST_AUTH_ENABLED": "false",
    "LEMON_SQUEEZY_STORE_ID": "",
    "LEMON_SQUEEZY_PRODUCT_ID": "",
    "LEMON_SQUEEZY_VARIANT_ID": "",
    "LEMON_SQUEEZY_STORE_HOST": "citescout.lemonsqueezy.com",
    "LEMON_SQUEEZY_TEST_MODE": "true",
    "RESEND_FROM_EMAIL": "CiteScout Staging <noreply@cite-scout.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFUdD5T5nSD0fMzM",
    "GLOBAL_DAILY_PROVIDER_CALL_CAP": "18",
    "PER_USER_MONTHLY_PROVIDER_CALL_CAP": "36",
    "MAX_PROVIDER_CALLS_PER_CRON_INVOCATION": "4",
  },
  "routes": [{ "pattern": "staging.cite-scout.com", "custom_domain": true }],
}
