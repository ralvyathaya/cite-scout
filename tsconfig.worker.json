{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/server",
    "src/db",
    "src/domain",
    "src/integrations",
    "src/shared",
    "tests/integration",
    "tests/env.d.ts"
  ]
}
