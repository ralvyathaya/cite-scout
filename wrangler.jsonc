{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "citescout",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
  },
  // The D1 database keeps its original name; only the Worker was renamed.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptwatch",
      "database_id": "6e530e47-7c40-48fb-97b9-3e625ce6389b",
      "migrations_dir": "./migrations",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "APP_ENV": "development",
    "DEPLOYMENT_ENV": "local",
    "EXTERNAL_INTEGRATIONS_ENABLED": "false",
    "V2_SCANS_ENABLED": "true",
    "GEO_SCANS_ENABLED": "false",
    "GEO_ANALYSIS_ENABLED": "false",
    "GEO_CLASSIFIER_MODEL": "clef-flash",
    "GEO_SERP_COLLECTOR": "serpapi",
    "GEO_OPENAI_MODEL": "gpt-6-luna",
    "GEO_INTERNAL_TEST_USER_ID": "",
    "GEO_INTERNAL_TEST_EXPIRES_AT": "",
    "GEO_SERPAPI_MONTHLY_REQUEST_CAP": "0",
    "GEO_INTERNAL_TEST_SPEND_CAP_USD": "0",
    "GEO_INTERNAL_TEST_PERPLEXITY_MAX_COST_USD": "0",
    "GEO_INTERNAL_TEST_OPENAI_MAX_COST_USD": "0",
    "GEO_INTERNAL_TEST_PROCESSING_MAX_COST_USD": "0",
    "GEO_PROCESSING_PROJECT_DAILY_CAP": "0",
    "GEO_PROCESSING_GLOBAL_DAILY_CAP": "0",
    "GEO_PAGE_CHECKS_ENABLED": "false",
    "GEO_GLOBAL_DAILY_CALL_CAP": "0",
    "GEO_PROJECT_DAILY_CALL_CAP": "0",
    "GEO_PROJECT_MONTHLY_CALL_CAP": "0",
    "TEST_AUTH_ENABLED": "true",
    "LEMON_SQUEEZY_STORE_ID": "476459",
    "LEMON_SQUEEZY_PRODUCT_ID": "1406363",
    "LEMON_SQUEEZY_VARIANT_ID": "2195435",
    "LEMON_SQUEEZY_STORE_HOST": "citescout.lemonsqueezy.com",
    "LEMON_SQUEEZY_TEST_MODE": "true",
    "RESEND_FROM_EMAIL": "CiteScout <noreply@cite-scout.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE5-VBuYDvz0bKyp",
    "GLOBAL_DAILY_PROVIDER_CALL_CAP": "150",
    "PER_USER_MONTHLY_PROVIDER_CALL_CAP": "350",
    "MAX_PROVIDER_CALLS_PER_CRON_INVOCATION": "20",
  },
}
