{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "citescout",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
  },
  // The D1 database keeps its original name; only the Worker was renamed.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptwatch",
      "database_id": "6e530e47-7c40-48fb-97b9-3e625ce6389b",
      "migrations_dir": "./migrations",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "APP_ENV": "development",
    "EXTERNAL_INTEGRATIONS_ENABLED": "false",
    "TEST_AUTH_ENABLED": "false",
    "LEMON_SQUEEZY_STORE_ID": "",
    "LEMON_SQUEEZY_PRODUCT_ID": "",
    "LEMON_SQUEEZY_VARIANT_ID": "",
    "LEMON_SQUEEZY_STORE_HOST": "",
    "LEMON_SQUEEZY_TEST_MODE": "true",
    "RESEND_FROM_EMAIL": "CiteScout <auth@example.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE5-VBuYDvz0bKyp",
    "GLOBAL_DAILY_PROVIDER_CALL_CAP": "100",
    "PER_USER_MONTHLY_PROVIDER_CALL_CAP": "350",
    "MAX_PROVIDER_CALLS_PER_CRON_INVOCATION": "20",
  },
}
