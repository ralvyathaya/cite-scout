{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production-only deploy config. Used by `npm run deploy` as:
  //   wrangler deploy --config wrangler.production.jsonc
  // `wrangler.jsonc` stays local-dev friendly and is the only file the
  // Cloudflare Vite plugin reads (it ignores `env` blocks, so environments
  // live here instead). Keep bindings (DB, ASSETS) in sync between both files.
  // No secrets in this file — set those with:
  //   wrangler secret put <NAME> --config wrangler.production.jsonc
  "name": "citescout",
  "main": "./dist/citescout/index.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
  },
  // The D1 database keeps its original name; only the Worker was renamed.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptwatch",
      "database_id": "6e530e47-7c40-48fb-97b9-3e625ce6389b",
      "migrations_dir": "./migrations",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // Explicit so `wrangler deploy` never silently disables the public
  // workers.dev route or the staging preview alias used by `deploy:preview`.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "vars": {
    "APP_URL": "https://cite-scout.com",
    "APP_ENV": "production",
    "EXTERNAL_INTEGRATIONS_ENABLED": "true",
    "V2_SCANS_ENABLED": "true",
    "GEO_SCANS_ENABLED": "false",
    "GEO_GLOBAL_DAILY_CALL_CAP": "0",
    "GEO_PROJECT_DAILY_CALL_CAP": "0",
    "GEO_PROJECT_MONTHLY_CALL_CAP": "0",
    "TEST_AUTH_ENABLED": "false",
    "LEMON_SQUEEZY_STORE_ID": "476459",
    "LEMON_SQUEEZY_PRODUCT_ID": "1406363",
    "LEMON_SQUEEZY_VARIANT_ID": "2195435",
    "LEMON_SQUEEZY_STORE_HOST": "citescout.lemonsqueezy.com",
    "LEMON_SQUEEZY_TEST_MODE": "true",
    "RESEND_FROM_EMAIL": "CiteScout <noreply@cite-scout.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE5-VBuYDvz0bKyp",
    "GLOBAL_DAILY_PROVIDER_CALL_CAP": "150",
    "PER_USER_MONTHLY_PROVIDER_CALL_CAP": "350",
    "MAX_PROVIDER_CALLS_PER_CRON_INVOCATION": "20",
  },
  "routes": [{ "pattern": "cite-scout.com", "custom_domain": true }],
}
